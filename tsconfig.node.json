{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/schema/**/*",
    "src/core/**/*",
    "src/server/**/*",
    "src/cli/**/*",
    "tests/unit/**/*",
    "tests/integration/**/*",
    "*.config.ts",
    "*.config.js"
  ],
  "exclude": ["node_modules", "dist", "tests/unit/web/**/*"]
}
